# Configuración de Supabase Auth (TASK-008).
#
# Copia este archivo a `.env` y rellena los dos valores con los de TU proyecto. `.env` está
# ignorado por git y no debe subirse nunca.
#
# Los dos valores son PÚBLICOS por diseño: viajan dentro del bundle del cliente, y el prefijo
# EXPO_PUBLIC_ es lo que hace que Expo los incruste al compilar.
#
# NUNCA pongas aquí la clave `service_role` ni el `client_secret` de Google: no se usan en el
# cliente, y comprometerían el proyecto entero (docs/SECURITY.md).
#
# Dónde se obtienen y qué URLs hay que registrar: docs/AUTH.md.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo para los tests E2E deterministas: sustituye el servicio de autenticación por un doble
# en memoria. Se ignora fuera de desarrollo, así que no puede activarse en producción.
# EXPO_PUBLIC_AUTH_FAKE=1
